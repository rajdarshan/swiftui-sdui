# ==========================================
# Xcode
# ==========================================
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore
.DS_Store
DerivedData/
*.xcuserstate
xcuserdata/
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
## Playgrounds
timeline.xctimeline
playground.xcworkspace
Pods/
build/
xcuserdata/
*.xcscmblueprint
*.xccheckout

# ==========================================
# Node / Dependency Management (npm & Husky)
# ==========================================
# Block the massive downloaded node modules directory
node_modules/

# Ignore local npm error logs and debug dumps
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.husky/_/

# ==========================================
# Linters & Code Quality Tools
# ==========================================
# Ignore local caching engines used by SwiftLint to speed up subsequent builds
.swiftlint-cache/

# Ignore generic compilation reports or code coverage artifacts
*.lint-report.txt
*.html
# Claude Code (not committed by policy)
# .claude/
# .claude-mem/
# .mcp.json
# CLAUDE.md

# Local design reference — screenshots of the reference app.
# Kept locally for visual comparison during development, never committed.
reference/

# ==========================================
# Perf harness output
# ==========================================
perf-output/